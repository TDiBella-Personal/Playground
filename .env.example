# Reddit API credentials (free)
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "create another app..." at the bottom
# 3. Select "script", give it a name, set redirect URI to http://localhost:8080
# 4. Copy the client ID (under the app name) and secret below
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-media-search/1.0

# YouTube Data API v3 key (free)
# 1. Go to https://console.cloud.google.com/apis/library/youtube.googleapis.com
# 2. Enable the YouTube Data API v3
# 3. Go to Credentials, create an API key, paste below
YOUTUBE_API_KEY=
